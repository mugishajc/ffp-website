# Sanity Configuration
# Get these values from your Sanity project dashboard at https://www.sanity.io/manage

# Your Sanity Project ID
VITE_SANITY_PROJECT_ID=your_project_id_here

# Dataset name (usually 'production')
VITE_SANITY_DATASET=production

# Optional: Auth token for authenticated requests (only needed for private data or mutations)
# VITE_SANITY_TOKEN=your_token_here

# Sanity Studio Configuration (for Studio only, not frontend)
SANITY_STUDIO_PROJECT_ID=your_project_id_here
SANITY_STUDIO_DATASET=production
